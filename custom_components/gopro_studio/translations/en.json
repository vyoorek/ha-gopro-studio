  "services": {
    "labs_command": {
      "name": "Send GoPro Labs command",
      "description": "Sends a GoPro Labs command over Wi-Fi (Labs firmware, HERO13 2.04.70+), no QR code needed.",
      "fields": {
        "config_entry_id": {
          "name": "Camera",
          "description": "Camera (optional when only one is configured)."
        },
        "command": {
          "name": "Command",
          "description": "Labs command, e.g. $HIST=5$LEVL=5 or *BITR=200."
        }
      }
    },
    "set_setting": {
      "name": "Set camera setting",
      "description": "Sets a camera setting by Open GoPro IDs.",
      "fields": {
        "config_entry_id": {
          "name": "Camera",
          "description": "Camera (optional)."
        },
        "setting_id": {
          "name": "Setting ID",
          "description": "e.g. 2 = resolution."
        },
        "option_id": {
          "name": "Option ID",
          "description": "e.g. 108 = 4K 8:7."
        }
      }
    },
    "load_preset": {
      "name": "Load preset",
      "description": "Loads a camera preset by its ID.",
      "fields": {
        "config_entry_id": {
          "name": "Camera",
          "description": "Camera (optional)."
        },
        "preset_id": {
          "name": "Preset ID",
          "description": "Preset ID (see attributes of the preset select)."
        }
      }
    },
    "download_media": {
      "name": "Download media",
      "description": "Downloads files from the camera to Home Assistant (default /media/gopro), including RAW .GPR.",
      "fields": {
        "config_entry_id": {
          "name": "Camera",
          "description": "Camera (optional)."
        },
        "files": {
          "name": "Files",
          "description": "Which files to download."
        },
        "path": {
          "name": "Path",
          "description": "A specific file, e.g. 100GOPRO/GX010001.MP4 (overrides Files)."
        },
        "include_raw": {
          "name": "Include RAW",
          "description": "Also download .GPR files of RAW photos."
        },
        "include_lrv": {
          "name": "Include LRV",
          "description": "Also download low-resolution .LRV proxies."
        },
        "directory": {
          "name": "Directory",
          "description": "Target directory."
        },
        "by_date": {
          "name": "Folders by date",
          "description": "Save into YYYY-MM-DD subfolders."
        },
        "skip_existing": {
          "name": "Skip existing",
          "description": "Do not download files that already exist."
        },
        "delete_after": {
          "name": "Delete after download",
          "description": "Delete from the camera after a successful download."
        }
      }
    },
    "delete_media": {
      "name": "Delete media",
      "description": "Deletes a file (or all files) from the camera SD card.",
      "fields": {
        "config_entry_id": {
          "name": "Camera",
          "description": "Camera (optional)."
        },
        "path": {
          "name": "Path",
          "description": "File to delete, e.g. 100GOPRO/GX010001.MP4."
        },
        "all": {
          "name": "All files",
          "description": "Delete ALL files from the card."
        }
      }
    },
    "http_get": {
      "name": "Raw API request",
      "description": "Sends any GET request to the Open GoPro API and returns the response.",
      "fields": {
        "config_entry_id": {
          "name": "Camera",
          "description": "Camera (optional)."
        },
        "path": {
          "name": "Path",
          "description": "e.g. /gopro/camera/state"
        }
      }
    }
  },
  "exceptions": {
    "option_rejected": {
      "message": "The camera rejected \"{option}\" for {setting}: not available with the current settings (resolution, frame rate, lens). Details: {error}"
    },
    "hilight_not_recording": {
      "message": "HiLight works only while recording."
    }
  },
  "device": {
    "section_video": {
      "name": "{model} – Video"
    },
    "section_photo": {
      "name": "{model} – Photo"
    },
    "section_timelapse": {
      "name": "{model} – Time Lapse"
    },
    "section_general": {
      "name": "{model} – General settings"
    }
  }
