{
  "config": {
    "step": {
      "user": {
        "title": "GoPro camera",
        "description": "Camera on the Home Network (COHN) uses HTTPS with username and password (the GoPro Labs command $SHPS=20 shows them on the camera). For camera Wi-Fi / USB disable HTTPS.",
        "data": {
          "host": "IP address",
          "username": "Username",
          "password": "Password",
          "https": "HTTPS (COHN)"
        }
      },
      "reconfigure": {
        "title": "Change camera connection",
        "data": {
          "host": "IP address",
          "username": "Username",
          "password": "Password",
          "https": "HTTPS (COHN)"
        }
      },
      "reauth_confirm": {
        "title": "Camera credentials changed",
        "data": {
          "username": "Username",
          "password": "Password"
        }
      }
    },
    "error": {
      "cannot_connect": "Camera does not respond. It must be powered on (a sleeping camera leaves the network) and reachable at this address.",
      "invalid_auth": "Invalid username or password.",
      "not_gopro": "The device did not respond like a GoPro camera."
    },
    "abort": {
      "already_configured": "This camera is already configured (address updated).",
      "reauth_successful": "Credentials updated.",
      "reconfigure_successful": "Connection updated.",
      "wrong_camera": "This is a different camera (serial number mismatch)."
    }
  },
